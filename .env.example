# ------------------------------------------------------------------------
# Copy this file to ".env" (no .example) and edit it.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / Mac:      cp .env.example .env
#
# .env is in .gitignore, so it NEVER gets committed or pushed.
# .env.example IS committed - it documents what settings exist, without
# leaking any secret. This is the standard pattern in every real project.
# ------------------------------------------------------------------------

# ==== WHICH BRAIN? ======================================================
# ollama = free, runs on your laptop, private, needs ~2.5 GB free RAM
# gemini = free cloud tier, no credit card, much smarter than a 3B model
# claude = paid, best quality (for Phase 5+ when planning gets hard)
AXON_PROVIDER=ollama


# ==== ollama (free, local) ==============================================
# Nothing to configure if you used the default install.
OLLAMA_MODEL=llama3.2:3b
# How long to hold the model in RAM. Loading takes ~60s on this laptop, so
# keep it at 5m while chatting. Use 30s only if you need the RAM back.
OLLAMA_KEEP_ALIVE=5m
# OLLAMA_HOST=http://127.0.0.1:11434


# ==== gemini (free cloud) ===============================================
# Get a key at https://aistudio.google.com/apikey - Google account, no card.
# Leave blank unless you set AXON_PROVIDER=gemini above.
GEMINI_API_KEY=
# Google retires models often. Run  py check.py --models  to see what your
# key actually supports.
#
# Measured on this key, Aug 2026 (4 calls each):
#   gemini-3.6-flash        4/4 ok, ~8s   <- capable AND reliable, use this
#   gemini-3.5-flash-lite   4/4 ok, ~1s   <- much faster, less clever
#   gemini-3.7-flash        3/4 ok, ~10s  <- newest, but often overloaded
GEMINI_MODEL=gemini-3.6-flash


# ==== claude (paid) =====================================================
# https://console.anthropic.com -> API Keys. Needs credit on the account.
ANTHROPIC_API_KEY=


# ==== wake word =========================================================
# Say this and Sid opens. Change it to anything - "hey sid", "computer",
# "hey buddy" - and it just works. No training, no account.
#
# vosk         : DEFAULT. Any phrase, no training, no account. Run once:
#                  py setup_wake_word.py
# openwakeword : a true wake-word net, but custom phrase = ~1h Colab training
# porcupine    : best accuracy; signup asks for a company email
AXON_WAKE_ENGINE=vosk
AXON_WAKE_WORD=hey sid
# AXON_WAKE_THRESHOLD=0.5
# PICOVOICE_ACCESS_KEY=


# ==== phone access ======================================================
# Password required to reach Sid from any device other than this computer.
# Generated automatically on first run - leave it blank and it fills itself.
# Delete the line and restart to revoke every paired device.
AXON_KEY=


# ==== server ============================================================
# 8000, 8100 and 3000 are already used by other apps on this machine.
AXON_PORT=8321

# Phase 10 - push notifications.
#
# A permanent https address for Sid. Push subscriptions are tied to the URL
# that created them, so with the free ngrok tunnel they die on restart. Set
# this to a stable domain and push survives.
# AXON_PUBLIC_ORIGIN=https://sid.yourdomain.com
#
# The contact address inside the signed push token. Nobody reads it, but
# Apple REJECTS addresses with fake domains (localhost, .local) - so if you
# change it, use a real domain.
# AXON_CONTACT_EMAIL=you@gmail.com
